.DS_Store
__pycache__/
*.pyc
.venv/
raw/
.worktrees/

# API keys. This MUST stay here: instantiate.py copies the toolkit's .env into
# the new repo so batch generation works from a sibling directory, and without
# this line the first `git add -A` publishes the key.
.env
.env.*
!.env.example

# Per-batch scratch manifest. Batches are merged into prompts.json with a
# `batch` field on every entry, so a committed additions.json is a stale
# duplicate of whichever batch ran last — and it was, twice.
additions.json
